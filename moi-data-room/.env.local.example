# Copy to .env.local and fill in. Never commit .env.local.

# Supabase: dashboard, the project, Settings, API.
# The URL and the anon key are public (the browser uses them); the service-role key is server side only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI: embeds every document for the index. Without it every upload ends failed.
OPENAI_API_KEY=

# Anthropic: the chat (inactive since August 2026). Leave empty unless the chat is switched back on.
ANTHROPIC_API_KEY=

# The admin page. Never leave it empty. Generate with: openssl rand -hex 32
ADMIN_SECRET=

# Chat limits. Optional; the defaults are 30 questions per address per hour, 500000 tokens a day,
# 8000 input tokens and 2048 output tokens. Counters reset on every restart.
# CLAUDE_PER_IP_HOURLY_LIMIT=
# CLAUDE_DAILY_TOKEN_BUDGET=
# CLAUDE_MAX_INPUT_TOKENS=
# CLAUDE_MAX_OUTPUT_TOKENS=
